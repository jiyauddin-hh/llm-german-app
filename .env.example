# --- German app backend ----------------------------------------------------
GERMAN_API_BASE=https://germanapp.100xsuite.com/api
# The app's x-api-key (the same one the Flutter app sends).
GERMAN_API_KEY=

# --- Brain -----------------------------------------------------------------
# Local model through Ollama by default (see "Local model" below).
# With TUTOR_BRAIN=claude or auto, the `claude` CLI and its login are used.
# TUTOR_MODEL=claude-haiku-4-5
# BRAIN_TIMEOUT=25
# CLAUDE_CLI=/home/you/.npm-global/bin/claude

# --- Voice -----------------------------------------------------------------
# This project's own XTTS server (./xtts/run.sh). Piper is the fallback.
# XTTS_URL=http://127.0.0.1:8300
# XTTS_SPEAKER=Ana Florence        (read by xtts/worker.py)

# --- Speech to text ----------------------------------------------------------
# WHISPER_MODEL=small
# WHISPER_DEVICE=auto      # auto | cuda | cpu
# WHISPER_LANG=auto
# MAX_AUDIO_SECONDS=30
# PIPER_VOICE_DE=de_DE-thorsten-medium
# PIPER_VOICE_EN=en_US-lessac-medium

# --- Limits ----------------------------------------------------------------
# MAX_SESSIONS=3
# SESSION_MINUTES=15
# DAILY_MINUTES=30        # 0 = no daily limit

# --- Server ----------------------------------------------------------------
# PORT=9950

# --- Local model -------------------------------------------------------------
# TUTOR_BRAIN=ollama      # ollama | claude | auto (claude, local model on failure)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_KEEP_ALIVE=10m

# --- Log page ----------------------------------------------------------------
# /logs.html works on this PC. To open it from outside through the tunnel,
# set a long random key and use /logs.html?key=<LOG_KEY>.
# LOG_KEY=
